/* Tinted railway palette; equivalent OKLCH tokens are documented in LifelinePalette. */
.lifeline-root { flex-grow: 1; color: rgb(32,49,48); background-color: rgb(246,241,226); font-size: 16px; }
.lifeline-screen { flex-grow: 1; align-self: center; width: 100%; max-width: 740px; }
.row { flex-direction: row; align-items: center; flex-shrink: 0; }
.column { flex-direction: column; }
.grow { flex-grow: 1; }
.header { padding: 8px 22px 7px; flex-shrink: 0; }
.brand { font-size: 26px; margin: 0; padding: 0; }
.eyebrow { font-size: 12px; letter-spacing: 1.2px; -unity-font-style: bold; margin-top: 5px; margin-bottom: 5px; }
.destination { font-size: 16px; color: rgb(73,88,76); margin-top: 1px; }
.resource { font-size: 20px; -unity-text-align: middle-right; -unity-font-style: bold; }
.resource-caption { font-size: 14px; -unity-text-align: middle-right; color: rgb(73,88,76); }
.world { min-height: 200px; flex-grow: 1; flex-shrink: 1; }
.world.focused { min-height: 170px; }
.strip { margin: 0 18px; padding: 5px 0; border-top-width: 1px; border-color: rgb(204,208,187); justify-content: space-between; }
.room-tab { flex-grow: 1; flex-basis: 0; min-height: 49px; margin: 0 2px; font-size: 14px; border-radius: 9px; }
.room-tab.selected { background-color: rgb(215,226,205); color: rgb(32,65,45); }
.sheet { padding: 9px 22px 13px; flex-shrink: 0; }
.sheet-title { font-size: 26px; margin-top: 1px; margin-bottom: 1px; white-space: normal; }
.sheet-info { font-size: 15px; color: rgb(73,88,76); white-space: normal; margin-top: 4px; margin-bottom: 7px; }
.room-actions { flex-direction: row; margin-top: 6px; }
.room-actions Button { flex-grow: 1; flex-basis: 0; margin-left: 3px; margin-right: 3px; }
.next-step { padding: 0 22px 8px; flex-shrink: 0; }
.next-title { font-size: 18px; -unity-font-style: bold; white-space: normal; margin-bottom: 2px; }
.next-detail { font-size: 15px; color: rgb(73,88,76); white-space: normal; margin-top: 2px; }
Button { min-height: 46px; border-width: 0; border-radius: 0; color: rgb(32,49,48); background-color: rgba(246,241,226,0); -unity-background-image-tint-color: rgba(246,241,226,0); margin: 0; font-size: 16px; white-space: normal; padding-left: 10px; padding-right: 10px; }
Button:hover { background-color: rgb(231,231,211); }
Button:focus { border-width: 2px; border-color: rgb(48,76,51); }
Button:disabled { color: rgb(105,113,99); background-color: rgb(226,226,209); }
.primary { background-color: rgb(49,82,56); color: rgb(246,241,226); border-radius: 10px; -unity-font-style: bold; min-height: 51px; }
.primary:hover { background-color: rgb(37,68,46); }
.secondary { background-color: rgb(226,229,211); border-radius: 10px; }
.small { min-height: 44px; font-size: 14px; }
.quiet { min-height: 44px; font-size: 15px; -unity-text-align: middle-left; padding-left: 0; }
.round { width: 44px; height: 44px; border-radius: 22px; font-size: 21px; }
.nav { flex-direction: row; flex-shrink: 0; padding: 4px 16px 6px; border-top-width: 1px; border-color: rgb(204,208,187); }
.nav Button { flex-grow: 1; flex-basis: 0; font-size: 16px; min-height: 52px; border-radius: 10px; }
.nav .active { -unity-font-style: bold; background-color: rgb(215,226,205); }
.page-scroll { flex-grow: 1; }
.page-content { padding: 4px 24px 26px; }
.page-title { font-size: 38px; white-space: normal; margin-top: 12px; margin-bottom: 8px; }
.paragraph { font-size: 16px; white-space: normal; color: rgb(73,88,76); margin-bottom: 18px; }
.section-heading { font-size: 26px; white-space: normal; margin-top: 20px; margin-bottom: 8px; }
.list-item { padding-top: 15px; padding-bottom: 16px; border-bottom-width: 1px; border-color: rgb(204,208,187); }
.item-title { font-size: 21px; white-space: normal; -unity-font-style: bold; margin: 0 0 5px; }
.item-detail { font-size: 15px; white-space: normal; color: rgb(73,88,76); margin: 3px 0 9px; }
.badge { font-size: 13px; -unity-font-style: bold; color: rgb(49,82,56); margin: 0 0 4px; }
.status { font-size: 14px; white-space: normal; height: 44px; flex-shrink: 0; padding: 4px 22px; color: rgb(91,63,28); }
.route-stop { padding: 18px 0; border-bottom-width: 1px; border-color: rgb(204,208,187); }
.route-number { font-size: 33px; color: rgb(114,95,43); width: 48px; }
.route-stop.current .item-title { color: rgb(49,82,56); }
.progress-track { height: 6px; border-radius: 3px; background-color: rgb(222,224,202); margin-top: 9px; margin-bottom: 8px; }
.progress-fill { height: 6px; background-color: rgb(103,130,74); border-radius: 3px; }
.welcome { padding: 12px 22px 16px; flex-shrink: 0; border-top-width: 1px; border-color: rgb(204,208,187); }
.welcome-title { font-size: 29px; white-space: normal; margin-bottom: 6px; }
.preference { min-height: 52px; -unity-text-align: middle-left; padding-left: 0; border-bottom-width: 1px; border-color: rgb(204,208,187); }
.compact .header { padding-top: 5px; padding-bottom: 3px; }
.compact .brand { font-size: 24px; }
.compact .sheet { padding-top: 4px; padding-bottom: 7px; }
.compact .sheet-title { font-size: 24px; }
.compact .room-tab { min-height: 44px; }
.compact .nav Button { min-height: 46px; }
.compact .next-step { padding-bottom: 5px; }
.compact .world { min-height: 150px; }

/* The diorama owns the canvas. Controls float at its edges like railway instruments. */
.immersive-stage { position: relative; min-height: 0; }
.world.immersive-world { position: absolute; top: 0; bottom: 0; left: 0; right: 0; min-height: 0; }
.game-header { position: absolute; top: 12px; left: 14px; right: 14px; height: 44px; }
.destination-chip { flex-shrink: 1; min-width: 0; }
.place-name { font-size: 22px; margin: 0 7px 0 0; white-space: nowrap; }
.icon-stat { flex-shrink: 0; margin-right: 8px; }
.stat-number { font-size: 16px; -unity-font-style: bold; margin: 0 0 0 5px; white-space: nowrap; }
.funds-chip { background-color: rgba(246,241,226,0.95); border-radius: 18px; padding: 6px 8px; margin-right: 5px; }
.funds-chip .stat-number { font-size: 14px; }
.icon-control { min-width: 44px; min-height: 44px; flex-shrink: 0; flex-direction: column; justify-content: center; align-items: center; padding: 5px; border-radius: 10px; }
.icon-control .icon-caption { font-size: 14px; -unity-text-align: middle-center; margin: 2px 0 0; padding: 0; white-space: nowrap; }
.icon-control.active, .icon-control.selected { background-color: rgb(213,224,197); color: rgb(32,65,45); }
.icon-control.primary { background-color: rgb(49,82,56); color: rgb(246,241,226); min-height: 44px; }
.icon-control.primary:disabled { background-color: rgb(101,112,89); color: rgb(246,241,226); }
.hud-round { width: 44px; min-height: 44px; border-radius: 22px; background-color: rgb(246,241,226); }
.hud-close { width: 44px; margin-left: 3px; }
.wide-icon { min-width: 106px; }
.game-nav { position: absolute; bottom: 9px; left: 62px; right: 62px; height: 55px; border-radius: 28px; background-color: rgb(246,241,226); padding: 3px; justify-content: space-around; }
.nav-icon { flex-grow: 1; flex-basis: 0; min-width: 44px; min-height: 49px; border-radius: 24px; margin: 0 2px; }
.nav-icon .lifeline-icon { width: 27px; height: 27px; }
.game-dock { position: absolute; bottom: 76px; left: 14px; right: 14px; flex-shrink: 0; padding: 9px 10px; border-radius: 14px; background-color: rgba(246,241,226,0.98); }
.dock-title { font-size: 22px; margin: 0 6px; white-space: normal; flex-shrink: 1; }
.hud-hint, .hud-note { font-size: 14px; white-space: normal; margin: 3px 6px; color: rgb(53,67,52); }
.hud-spaced { justify-content: space-between; }
.hud-actions { margin-top: 5px; }
.hud-actions > Button { flex-grow: 1; flex-basis: 0; min-width: 44px; margin: 0 2px; }
.choice-icon { height: 57px; background-color: rgb(226,229,211); }
.mission-dock { min-height: 52px; }
.mission-dock .progress-track { margin-top: 4px; margin-bottom: 3px; margin-right: 9px; }
.room-marker { position: absolute; width: 44px; height: 44px; border-radius: 22px; background-color: rgb(246,241,226); border-width: 1px; border-color: rgb(183,195,160); }
.room-marker.needs-crew { border-width: 2px; border-color: rgb(167,107,37); }
.queue-count { position: absolute; top: -6px; right: -5px; min-width: 21px; height: 21px; padding: 1px 4px; border-radius: 11px; background-color: rgb(178,117,44); color: rgb(250,243,227); font-size: 14px; -unity-text-align: middle-center; }
.game-toast { position: absolute; top: 66px; left: 22px; right: 22px; padding: 9px 12px; border-radius: 10px; font-size: 14px; white-space: normal; color: rgb(64,67,44); background-color: rgb(246,241,226); }
.shift-hud { position: absolute; top: 64px; left: 14px; padding: 3px 8px; border-radius: 24px; background-color: rgb(246,241,226); }
.hud-depot-actions, .hud-preferences, .hud-store-actions, .hud-tip-actions { justify-content: space-around; }
.hud-depot-actions > Button { flex-grow: 1; flex-basis: 0; }
.hud-preferences { margin-bottom: 6px; }
.hud-swatches { margin-bottom: 3px; }
.page-scroll { margin-bottom: 80px; }
